# Database
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Firebase Admin SDK (for push notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# FCM Server Key (Legacy - for simple implementation)
FCM_SERVER_KEY=your-fcm-server-key

# JWT Secret for authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Change this to a random secret in production!
JWT_SECRET=your-secret-key-change-this-in-production-use-crypto-randomBytes

# Node Environment
NODE_ENV=development

# Redis (Dùng cho BullMQ)
# Môi trường Local dev thông thường không cần đặt nếu cài Redis locally (Mặc định là 127.0.0.1:6379)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
