generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model menu_types {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @db.VarChar(255)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  warehouse_id      String?             @db.Uuid
  categories        categories[]
  warehouses        warehouses?         @relation("warehouse_menu_types", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier_products supplier_products[]

  @@unique([warehouse_id, name], map: "idx_menu_types_warehouse_name")
}

model categories {
  id                             String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                           String                           @db.VarChar(255)
  created_at                     DateTime?                        @default(now()) @db.Timestamp(6)
  updated_at                     DateTime?                        @default(now()) @db.Timestamp(6)
  menu_type_id                   String?                          @db.Uuid
  warehouse_id                   String?                          @db.Uuid
  warehouses                     warehouses?                      @relation("warehouse_categories", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  menu_types                     menu_types?                      @relation(fields: [menu_type_id], references: [id], onUpdate: NoAction, map: "fk_categories_menu_type")
  product_recipes                product_recipes[]
  products                       products[]
  supplier_products              supplier_products[]
  warehouse_category_permissions warehouse_category_permissions[]
  printer_mappings               printer_category_mappings[]

  @@index([name], map: "idx_categories_name")
  @@index([menu_type_id], map: "idx_categories_menu_type")
  @@index([warehouse_id], map: "idx_categories_warehouse")
}

model inventory_check_items {
  id                               String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  check_id                         String                             @db.Uuid
  product_id                       String                             @db.Uuid
  opening_balance                  Decimal?                           @default(0) @db.Decimal(18, 6)
  imports                          Decimal?                           @default(0) @db.Decimal(18, 6)
  exports                          Decimal?                           @default(0) @db.Decimal(18, 6)
  system_balance                   Decimal?                           @default(0) @db.Decimal(18, 6)
  actual_balance                   Decimal?                           @default(0) @db.Decimal(18, 6) // Changed from Int to Decimal to support fractional counts (e.g. 1.5kg)
  difference                       Decimal?                           @default(0) @db.Decimal(18, 6)
  difference_percentage            Decimal?                           @default(0) @db.Decimal(10, 2)
  created_at                       DateTime?                          @default(now()) @db.Timestamp(6)
  input_unit_id                    String?                            @db.Uuid
  input_value                      Decimal?                           @db.Decimal(18, 6)
  inventory_check_adjustment_items inventory_check_adjustment_items[] @relation("inventory_check_adjustment_items_check_item")
  inventory_checks                 inventory_checks                   @relation(fields: [check_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inventory_check_items_check")
  input_unit                       product_units?                     @relation(fields: [input_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_check_items_input_unit")
  products                         products                           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_check_items_product")

  @@index([check_id], map: "idx_inventory_check_items_check")
  @@index([input_unit_id], map: "idx_inventory_check_items_input_unit")
}

model inventory_checks {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number                      String                       @unique @db.VarChar(100)
  warehouse_id                String                       @db.Uuid
  period                      String                       @db.VarChar(50)
  created_by                  String?                      @db.VarChar(100)
  created_at                  DateTime?                    @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime?                    @default(now()) @db.Timestamptz(6)
  status                      inventory_check_status       @default(IN_PROGRESS)
  inventory_check_completions inventory_check_completions? @relation("inventory_check_completions_check")
  inventory_check_items       inventory_check_items[]
  warehouses                  warehouses                   @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_checks_warehouse")

  @@index([created_at], map: "idx_inventory_checks_created_at")
  @@index([warehouse_id], map: "idx_inventory_checks_warehouse")
}

model inventory_intakes {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intake_number         String                  @unique @db.VarChar(100)
  warehouse_id          String                  @db.Uuid
  created_by            String                  @db.Uuid
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  approved_at_bm        DateTime?               @db.Timestamp(6)
  approved_at_warehouse DateTime?               @db.Timestamp(6)
  approved_by_bm        String?                 @db.Uuid
  approved_by_warehouse String?                 @db.Uuid
  bm_notes              String?
  notes                 String?
  rejected_at           DateTime?               @db.Timestamp(6)
  rejected_by           String?                 @db.Uuid
  rejection_reason      String?
  status                inventory_intake_status @default(PENDING_WAREHOUSE_APPROVAL)
  updated_at            DateTime?               @default(now()) @db.Timestamp(6)
  warehouse_notes       String?
  bm_approver           users?                  @relation("intake_bm_approver", fields: [approved_by_bm], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse_approver    users?                  @relation("intake_warehouse_approver", fields: [approved_by_warehouse], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users                   @relation("intake_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rejector              users?                  @relation("intake_rejector", fields: [rejected_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses            warehouses              @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_inventory_intakes_created_at")
  @@index([status], map: "idx_inventory_intakes_status")
  @@index([warehouse_id, status], map: "idx_inventory_intakes_warehouse_status")
}

model inventory_loss_reports {
  id                                              String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_number                                   String                        @unique @db.VarChar(100)
  warehouse_id                                    String                        @db.Uuid
  product_id                                      String?                       @db.Uuid
  quantity_lost                                   Decimal?                      @db.Decimal(18, 6)
  reason                                          String?                       @db.VarChar(255)
  reported_by                                     String                        @db.Uuid
  approved_by                                     String?                       @db.Uuid
  created_at                                      DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                                      DateTime?                     @default(now()) @db.Timestamp(6)
  inventory_loss_report_items                     inventory_loss_report_items[]
  users_inventory_loss_reports_approved_byTousers users?                        @relation("inventory_loss_reports_approved_byTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products                                        products?                     @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_inventory_loss_reports_reported_byTousers users                         @relation("inventory_loss_reports_reported_byTousers", fields: [reported_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses                                      warehouses                    @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([warehouse_id], map: "idx_inventory_loss_warehouse")
}

model inventory_loss_report_items {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id              String                 @db.Uuid
  product_id             String                 @db.Uuid
  unit_id                String                 @db.Uuid
  quantity_lost          Decimal                @db.Decimal(18, 6)
  unit_price             Decimal?               @db.Decimal(12, 2)
  created_at             DateTime?              @default(now()) @db.Timestamp(6)
  updated_at             DateTime?              @default(now()) @db.Timestamp(6)
  products               products               @relation("inventory_loss_report_items_products", fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_loss_reports inventory_loss_reports @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_units          product_units          @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([report_id], map: "idx_inventory_loss_report_items_report")
  @@index([product_id], map: "idx_inventory_loss_report_items_product")
}

model product_units {
  id                                                        String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                                                      String                            @db.VarChar(50)
  name                                                      String                            @db.VarChar(255)
  description                                               String?
  created_at                                                DateTime?                         @default(now()) @db.Timestamp(6)
  updated_at                                                DateTime?                         @default(now()) @db.Timestamp(6)
  warehouse_id                                              String?                           @db.Uuid
  external_sales_export_items                               external_sales_export_items[]     @relation("external_export_items_unit")
  internal_transfer_items_exported_unit                     internal_transfer_request_items[] @relation("internal_transfer_items_exported_unit")
  internal_transfer_items_manager_unit                      internal_transfer_request_items[] @relation("internal_transfer_items_manager_unit")
  internal_transfer_items_received_unit                     internal_transfer_request_items[] @relation("internal_transfer_items_received_unit")
  internal_transfer_items_requested_unit                    internal_transfer_request_items[] @relation("internal_transfer_items_requested_unit")
  inventory_check_items                                     inventory_check_items[]
  inventory_import_items                                    inventory_import_items[]          @relation("inventory_import_items_unit")
  inventory_loss_report_items                               inventory_loss_report_items[]
  product_package_units                                     product_package_units[]
  product_recipes                                           product_recipes[]
  warehouses                                                warehouses?                       @relation("warehouse_units", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products                                                  products[]
  purchase_order_items                                      purchase_order_items[]            @relation("purchase_order_items_unit")
  purchase_orders_detail_items                              purchase_orders_detail_items[]
  recipe_ingredients                                        recipe_ingredients[]
  supplier_products                                         supplier_products[]               @relation("supplier_products_unit")
  unit_relations_unit_relations_from_unit_idToproduct_units unit_relations[]                  @relation("unit_relations_from_unit_idToproduct_units")
  unit_relations_unit_relations_to_unit_idToproduct_units   unit_relations[]                  @relation("unit_relations_to_unit_idToproduct_units")
  warehouse_stock_realtime                                  warehouse_stock_realtime[]        @relation("warehouse_stock_realtime_unit")
  warehouse_transfer_items_approved_unit                    warehouse_transfer_items[]        @relation("warehouse_transfer_items_approved_unit")
  warehouse_transfer_items_manager_approved_unit            warehouse_transfer_items[]        @relation("warehouse_transfer_items_manager_approved_unit")
  warehouse_transfer_items_original_unit                    warehouse_transfer_items[]        @relation("warehouse_transfer_items_unit")

  @@unique([warehouse_id, code], map: "idx_product_units_warehouse_code")
  @@index([warehouse_id], map: "idx_product_units_warehouse")
}

model products {
  id                               String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                             String                             @db.VarChar(100)
  name                             String                             @db.VarChar(255)
  unit_id                          String                             @db.Uuid
  created_at                       DateTime?                          @default(now()) @db.Timestamp(6)
  updated_at                       DateTime?                          @default(now()) @db.Timestamp(6)
  category_id                      String?                            @db.Uuid
  price                            Decimal?                           @db.Decimal(12, 2)
  warehouse_id                     String?                            @db.Uuid
  external_sales_export_items      external_sales_export_items[]      @relation("external_export_items_product")
  internal_transfer_items          internal_transfer_request_items[]  @relation("internal_transfer_items_product")
  inventory_adjustment_items       inventory_adjustment_items[]       @relation("inventory_adjustment_items_product")
  inventory_check_adjustment_items inventory_check_adjustment_items[] @relation("inventory_check_adjustment_items_product")
  inventory_check_items            inventory_check_items[]
  inventory_import_items           inventory_import_items[]           @relation("inventory_import_items_product")
  inventory_loss_report_items      inventory_loss_report_items[]      @relation("inventory_loss_report_items_products")
  inventory_loss_reports           inventory_loss_reports[]
  inventory_snapshots              inventory_snapshots[]              @relation("inventory_snapshots_product")
  product_package_units            product_package_units[]
  product_recipes                  product_recipes[]
  production_ingredient_usages     production_ingredient_usages[]     @relation("production_ingredient_usages_ingredient")
  categories                       categories?                        @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_units                    product_units                      @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses_product_owner         warehouses?                        @relation("warehouse_products", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotion_gifts                  promotion_gifts[]
  promotion_products               promotion_products[]
  purchase_order_items             purchase_order_items[]
  recipe_deduction_items           recipe_deduction_items[]           @relation("recipe_deduction_items_ingredient")
  recipe_ingredients               recipe_ingredients[]               @relation("recipe_ingredients_ingredient")
  warehouse_stock                  warehouse_stock[]
  warehouse_stock_realtime         warehouse_stock_realtime[]         @relation("warehouse_stock_realtime_product")
  warehouse_transfer_items         warehouse_transfer_items[]

  @@unique([warehouse_id, code], map: "idx_products_warehouse_code")
  @@index([warehouse_id], map: "idx_products_warehouse_id")
  @@index([category_id], map: "idx_products_category")
  @@index([code], map: "idx_products_code")
}

model purchase_order_items {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchase_order_id String          @db.Uuid
  product_id        String          @db.Uuid
  quantity          Int
  unit_price        Decimal?        @db.Decimal(12, 2)
  line_total        Decimal?        @db.Decimal(15, 2)
  created_at        DateTime?       @default(now()) @db.Timestamp(6)
  unit_id           String?         @db.Uuid
  products          products        @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders   purchase_orders @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_units     product_units?  @relation("purchase_order_items_unit", fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([unit_id], map: "idx_purchase_order_items_unit")
}

model purchase_orders {
  id                                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  po_number                                String                 @unique @db.VarChar(100)
  warehouse_id                             String                 @db.Uuid
  supplier_name                            String?                @db.VarChar(255)
  status                                   purchase_order_status? @default(DRAFT)
  total_amount                             Decimal?               @db.Decimal(15, 2)
  created_by                               String                 @db.Uuid
  approved_by                              String?                @db.Uuid
  received_at                              DateTime?              @db.Timestamp(6)
  created_at                               DateTime?              @default(now()) @db.Timestamp(6)
  updated_at                               DateTime?              @default(now()) @db.Timestamp(6)
  purchase_order_items                     purchase_order_items[]
  users_purchase_orders_approved_byTousers users?                 @relation("purchase_orders_approved_byTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_purchase_orders_created_byTousers  users                  @relation("purchase_orders_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses                               warehouses             @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_purchase_orders_status")
  @@index([warehouse_id], map: "idx_purchase_orders_warehouse")
}

model inventory_imports {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  import_number String                   @unique @db.VarChar(100)
  warehouse_id  String                   @db.Uuid
  supplier_name String?                  @db.VarChar(255)
  import_date   DateTime                 @db.Timestamp(6)
  total_amount  Decimal?                 @db.Decimal(15, 2)
  notes         String?
  created_by    String                   @db.Uuid
  created_at    DateTime                 @default(now()) @db.Timestamp(6)
  items         inventory_import_items[]
  user          users                    @relation("inventory_imports_user", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse     warehouses               @relation("inventory_imports_warehouse", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([warehouse_id, import_date], map: "idx_inventory_imports_warehouse_date")
  @@index([import_date], map: "idx_inventory_imports_date")
  @@index([created_by], map: "idx_inventory_imports_user")
}

model inventory_import_items {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  import_id               String            @db.Uuid
  product_id              String            @db.Uuid
  quantity                Decimal           @db.Decimal(18, 6)
  input_unit_id           String            @db.Uuid
  base_quantity           Decimal           @db.Decimal(18, 6)
  unit_price              Decimal?          @db.Decimal(12, 2)
  line_total              Decimal?          @db.Decimal(15, 2)
  batch_number            String?           @db.VarChar(100)
  expiry_date             DateTime?         @db.Date
  created_at              DateTime          @default(now()) @db.Timestamp(6)
  stock_after_transaction Int?
  import                  inventory_imports @relation(fields: [import_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  input_unit              product_units     @relation("inventory_import_items_unit", fields: [input_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product                 products          @relation("inventory_import_items_product", fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([import_id], map: "idx_inventory_import_items_import")
  @@index([product_id], map: "idx_inventory_import_items_product")
}

model recipe_deductions {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id      String                   @db.Uuid
  invoice_item_id String                   @db.Uuid
  recipe_id       String                   @db.Uuid
  warehouse_id    String                   @db.Uuid
  quantity_sold   Int
  deduction_date  DateTime                 @db.Timestamp(6)
  created_at      DateTime                 @default(now()) @db.Timestamp(6)
  ingredients     recipe_deduction_items[]
  invoice         sales_invoices           @relation("recipe_deductions_invoice", fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoice_item    sales_invoice_items      @relation("recipe_deductions_invoice_item", fields: [invoice_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipe          product_recipes          @relation("recipe_deductions_recipe", fields: [recipe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse       warehouses               @relation("recipe_deductions_warehouse", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_recipe_deductions_invoice")
  @@index([warehouse_id, deduction_date], map: "idx_recipe_deductions_warehouse_date")
  @@index([recipe_id], map: "idx_recipe_deductions_recipe")
}

model recipe_deduction_items {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deduction_id      String            @db.Uuid
  ingredient_id     String            @db.Uuid
  quantity_deducted Int
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  deduction         recipe_deductions @relation(fields: [deduction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingredient        products          @relation("recipe_deduction_items_ingredient", fields: [ingredient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([deduction_id], map: "idx_recipe_deduction_items_deduction")
  @@index([ingredient_id], map: "idx_recipe_deduction_items_ingredient")
}

model production_transactions {
  id                String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  production_number String                         @unique @db.VarChar(100)
  warehouse_id      String                         @db.Uuid
  recipe_id         String                         @db.Uuid
  quantity_produced Int
  production_date   DateTime                       @db.Timestamp(6)
  notes             String?
  created_by        String                         @db.Uuid
  created_at        DateTime                       @default(now()) @db.Timestamp(6)
  ingredients       production_ingredient_usages[]
  user              users                          @relation("production_transactions_user", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipe            product_recipes                @relation("production_transactions_recipe", fields: [recipe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse         warehouses                     @relation("production_transactions_warehouse", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([warehouse_id, production_date], map: "idx_production_transactions_warehouse_date")
  @@index([recipe_id], map: "idx_production_transactions_recipe")
  @@index([created_by], map: "idx_production_transactions_user")
}

model production_ingredient_usages {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  production_id String                  @db.Uuid
  ingredient_id String                  @db.Uuid
  quantity_used Int
  created_at    DateTime                @default(now()) @db.Timestamp(6)
  ingredient    products                @relation("production_ingredient_usages_ingredient", fields: [ingredient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  production    production_transactions @relation(fields: [production_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([production_id], map: "idx_production_ingredient_usages_production")
  @@index([ingredient_id], map: "idx_production_ingredient_usages_ingredient")
}

model inventory_adjustments {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adjustment_number String                       @unique @db.VarChar(100)
  warehouse_id      String                       @db.Uuid
  adjustment_type   String                       @db.VarChar(50)
  reason            String
  adjustment_date   DateTime                     @db.Timestamp(6)
  approved_by       String?                      @db.Uuid
  created_by        String                       @db.Uuid
  created_at        DateTime                     @default(now()) @db.Timestamp(6)
  items             inventory_adjustment_items[]
  approver          users?                       @relation("inventory_adjustments_approved", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator           users                        @relation("inventory_adjustments_created", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse         warehouses                   @relation("inventory_adjustments_warehouse", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([warehouse_id, adjustment_date], map: "idx_inventory_adjustments_warehouse_date")
  @@index([created_by], map: "idx_inventory_adjustments_created_by")
}

model inventory_adjustment_items {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adjustment_id   String                @db.Uuid
  product_id      String                @db.Uuid
  quantity_before Decimal               @db.Decimal(18, 6)
  quantity_after  Decimal               @db.Decimal(18, 6)
  quantity_change Decimal               @db.Decimal(18, 6)
  notes           String?
  created_at      DateTime              @default(now()) @db.Timestamp(6)
  adjustment      inventory_adjustments @relation(fields: [adjustment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product         products              @relation("inventory_adjustment_items_product", fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([adjustment_id], map: "idx_inventory_adjustment_items_adjustment")
  @@index([product_id], map: "idx_inventory_adjustment_items_product")
}

model inventory_check_completions {
  id                String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  check_id          String                             @unique(map: "idx_inventory_check_completions_check_unique") @db.Uuid
