model internal_transfer_requests {
  id                       String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_number           String                            @unique @db.VarChar(100)
  from_warehouse_id        String                            @db.Uuid
  to_warehouse_id          String                            @db.Uuid
  status                   internal_transfer_status          @default(CHO_QUAN_LY_DUYET)
  created_by               String                            @db.Uuid
  created_at               DateTime?                         @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                         @default(now()) @db.Timestamp(6)
  manager_approved_by      String?                           @db.Uuid
  manager_approved_at      DateTime?                         @db.Timestamp(6)
  manager_notes            String?
  gm_approved_by           String?                           @db.Uuid
  gm_approved_at           DateTime?                         @db.Timestamp(6)
  gm_notes                 String?
  exported_by              String?                           @db.Uuid
  exported_at              DateTime?                         @db.Timestamp(6)
  export_notes             String?
  received_by              String?                           @db.Uuid
  received_at              DateTime?                         @db.Timestamp(6)
  has_discrepancy          Boolean                           @default(false)
  discrepancy_confirmed_by String?                           @db.Uuid
  discrepancy_confirmed_at DateTime?                         @db.Timestamp(6)
  rejected_by              String?                           @db.Uuid
  rejection_reason         String?
  items                    internal_transfer_request_items[]
  users_created            users                             @relation("internal_transfers_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_discrepancy        users?                            @relation("internal_transfers_discrepancy_confirmed", fields: [discrepancy_confirmed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_exported           users?                            @relation("internal_transfers_exported_by", fields: [exported_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses_from          warehouses                        @relation("internal_transfers_from_warehouse", fields: [from_warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_gm                 users?                            @relation("internal_transfers_gm_approved", fields: [gm_approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_manager            users?                            @relation("internal_transfers_manager_approved", fields: [manager_approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_received           users?                            @relation("internal_transfers_received_by", fields: [received_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_rejected           users?                            @relation("internal_transfers_rejected_by", fields: [rejected_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses_to            warehouses                        @relation("internal_transfers_to_warehouse", fields: [to_warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([from_warehouse_id], map: "idx_internal_transfers_from")
  @@index([to_warehouse_id], map: "idx_internal_transfers_to")
  @@index([status], map: "idx_internal_transfers_status")
  @@index([created_at], map: "idx_internal_transfers_created")
}

model internal_transfer_request_items {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id           String                     @db.Uuid
  product_id           String                     @db.Uuid
  requested_quantity   Decimal                    @db.Decimal(18, 6)
  requested_unit_id    String                     @db.Uuid
  manager_quantity     Decimal?                   @db.Decimal(18, 6)
  manager_unit_id      String?                    @db.Uuid
  current_stock        Decimal?                   @db.Decimal(18, 6)
  exported_quantity    Decimal?                   @db.Decimal(18, 6)
  exported_unit_id     String?                    @db.Uuid
  main_stock_before    Decimal?                   @db.Decimal(18, 6)
  received_quantity    Decimal?                   @db.Decimal(18, 6)
  received_unit_id     String?                    @db.Uuid
  discrepancy_quantity Decimal?                   @db.Decimal(18, 6)
  confirmed_quantity   Decimal?                   @db.Decimal(18, 6)
  created_at           DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at           DateTime?                  @default(now()) @db.Timestamp(6)
  exported_unit        product_units?             @relation("internal_transfer_items_exported_unit", fields: [exported_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manager_unit         product_units?             @relation("internal_transfer_items_manager_unit", fields: [manager_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product              products                   @relation("internal_transfer_items_product", fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  received_unit        product_units?             @relation("internal_transfer_items_received_unit", fields: [received_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request              internal_transfer_requests @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requested_unit       product_units              @relation("internal_transfer_items_requested_unit", fields: [requested_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([request_id], map: "idx_internal_transfer_items_request")
  @@index([product_id], map: "idx_internal_transfer_items_product")
}

